# Installed by tools/ai_patch_bridge/scripts/install_user_service.sh
# This template is documentation only; the installer writes absolute paths.

[Unit]
Description=NVDA10 AI patch bridge watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__NVDA10_REPO_ROOT__/tools/ai_patch_bridge
Environment=AI_PATCH_REPO_ROOT=__NVDA10_REPO_ROOT__
Environment=AI_PATCH_REPO=JayDEmily/nvda10
Environment=AI_PATCH_ISSUE=2
Environment=AI_PATCH_BASE=main
Environment=AI_PATCH_LOCAL_CHECK=make scaffold-check
Environment=AI_PATCH_POLL_SECONDS=60
ExecStart=/usr/bin/env bash -lc 'make ai-bridge-watch'
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
