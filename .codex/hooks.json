{
  "description": "NVDA minimal Gate 0 lifecycle evidence hooks.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run_gate0_attest.sh\"",
            "statusMessage": "Recording NVDA Gate 0 probe result",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run_gate0_attest.sh\"",
            "statusMessage": "Checking NVDA Gate 0 command",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 1200,
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run_gate0_attest.sh\"",
            "statusMessage": "Binding NVDA Gate 0 session",
            "type": "command"
          }
        ],
        "matcher": "startup"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 1200,
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run_gate0_attest.sh\"",
            "statusMessage": "Binding NVDA Gate 0 subagent",
            "type": "command"
          },
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run_runtime_identity_attest.sh\"",
            "statusMessage": "Recording NVDA authenticated runtime identity",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run_gate0_attest.sh\"",
            "statusMessage": "Recording NVDA Gate 0 subagent stop",
            "type": "command"
          },
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run_runtime_identity_attest.sh\"",
            "statusMessage": "Recording NVDA authenticated runtime identity",
            "type": "command"
          }
        ]
      }
    ]
  }
}
