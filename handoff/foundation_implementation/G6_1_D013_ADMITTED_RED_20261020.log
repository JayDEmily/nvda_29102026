            ("1", "3", 100, 1),
            ("102", "100", -200, 101),
            ("-3", "-1", -100, 1),
            ("100.00", "100.0", 0, 1),
            ("-0.000", "2.00", 200, 1),
            ("-1", "1", None, None),
            ("-0.000", "0.00", None, None),
            ("1E+5000", "3E+5000", 100, 1),
            ("1E-5000", "3E-5000", 100, 1),
            ("-1", "1." + "0" * 4999 + "1", 4 * 10**5002 + 200, 1),
            ("1", "1." + "0" * 4999 + "1", 200, 2 * 10**5000 + 1),
        ],
        ids=[
            "nonterminating",
            "integer",
            "crossed",
            "negative",
            "zero",
            "signed-zero-input",
            "zero-midpoint",
            "all-zero",
            "large-exponent",
            "tiny-exponent",
            "huge-numerator-wire",
            "huge-denominator-wire",
        ],
    )
    def test_d013_exact_ratio_canonical_domain(tmp_path, bid, ask, numerator, denominator):
