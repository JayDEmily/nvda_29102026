                    return replace(
                        page, items=tuple(replace(x, projection_mapping_id="other") for x in page.items)
                    )
                metadata = {
                    "mapping-version": {"projection_mapping_version": 2},
                    "field-mismatch": {"native_field_path": ("quote", "other")},
