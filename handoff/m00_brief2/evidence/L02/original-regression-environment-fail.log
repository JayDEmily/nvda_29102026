                api.concept_id("raw_signal.capture_receipt_presence_assessment"),
                api.contract_id("nvda.raw_signal.CaptureReceiptPresenceAssessment.v1"),
                "not_applicable",
                api.assessment_occurrence_id(nonce),
                capture.capture_occurrence_id,
                "zero_received",
