{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sequence5_temporal_calendar_event_context_inventory.schema.json",
  "title": "Sequence 5 temporal/calendar/event context inventory",
  "type": "object",
  "required": [
    "schema_version",
    "sequence",
    "tranche",
    "result",
    "source_lock",
    "upstream_accounting",
    "sequence5_relevant_record_universe",
    "runtime_mutation_posture",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "sequence5_temporal_calendar_event_context_inventory.v1"
    },
    "sequence": {
      "const": "Sequence 5"
    },
    "tranche": {
      "type": "string"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "HOLD",
        "LAWFUL_STOP"
      ]
    },
    "source_lock": {
      "type": "object"
    },
    "upstream_accounting": {
      "type": "object"
    },
    "sequence5_relevant_record_universe": {
      "type": "object"
    },
    "runtime_mutation_posture": {
      "type": "object"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "stable_record_key",
          "atlas_record_id",
          "source_slice_filename",
          "selection_reasons",
          "sequence5_disposition",
          "lawful_temporal_or_context_home",
          "context_type",
          "event_posture",
          "scheduled_unscheduled_posture",
          "routing_evaluation_role",
          "allowed_downstream_consumers",
          "forbidden_alpha_sentiment_posture",
          "next_action"
        ]
      }
    }
  },
  "additionalProperties": true
}
