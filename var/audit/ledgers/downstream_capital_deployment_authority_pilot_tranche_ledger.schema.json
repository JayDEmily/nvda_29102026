{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "downstream_capital_deployment_authority_pilot_tranche_ledger",
  "type": "object",
  "required": [
    "schema_version",
    "tranche_id",
    "status",
    "blueprint_surface",
    "target_owner",
    "scope_record_count",
    "scope_record_ids",
    "record_summaries",
    "leaf_queue",
    "creation_guardrails",
    "parent_brief",
    "closeout_state"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "tranche_id": {"type": "string"},
    "status": {"enum": ["open", "closed"]},
    "blueprint_surface": {"type": "string"},
    "target_owner": {"type": "string"},
    "scope_record_count": {"type": "integer", "minimum": 1},
    "scope_record_ids": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "record_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "satisfaction_record_id",
          "atlas_record_id",
          "intent_unit_id",
          "native_satisfaction_status",
          "implementation_leaf_type",
          "bridge_evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "satisfaction_record_id": {"type": "string"},
          "atlas_record_id": {"type": "string"},
          "intent_unit_id": {"type": "string"},
          "native_satisfaction_status": {"type": "string"},
          "implementation_leaf_type": {"type": "string"},
          "bridge_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "line_start", "line_end", "evidence_type"],
              "additionalProperties": false,
              "properties": {
                "path": {"type": "string"},
                "line_start": {"type": "integer", "minimum": 1},
                "line_end": {"type": "integer", "minimum": 1},
                "evidence_type": {"type": "string"}
              }
            }
          },
          "decision_notes": {"type": "string"}
        }
      }
    },
    "leaf_queue": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["leaf_id", "status", "leaf_type", "source_record_id", "bounded_job"],
        "additionalProperties": false,
        "properties": {
          "leaf_id": {"type": "string"},
          "status": {"enum": ["queued", "in_progress", "closed"]},
          "leaf_type": {"type": "string"},
          "source_record_id": {"type": ["string", "null"]},
          "bounded_job": {"type": "string"}
        }
      }
    },
    "creation_guardrails": {
      "type": "object",
      "required": [
        "runtime_implementation_performed",
        "feature_test_modification_performed",
        "vocabulary_admission_performed",
        "full_atlas_batch_processed"
      ],
      "additionalProperties": false,
      "properties": {
        "runtime_implementation_performed": {"type": "boolean"},
        "feature_test_modification_performed": {"type": "boolean"},
        "vocabulary_admission_performed": {"type": "boolean"},
        "full_atlas_batch_processed": {"type": "boolean"}
      }
    },
    "parent_brief": {
      "type": "object",
      "required": ["path", "sha256", "status"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"type": "string"}
      }
    },
    "closeout_state": {
      "type": "object",
      "required": ["status", "mandatory_closeout_leaf_id", "promotion_ready"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["not_started", "in_progress", "closed"]},
        "mandatory_closeout_leaf_id": {"type": "string"},
        "promotion_ready": {"type": "boolean"}
      }
    }
  }
}
