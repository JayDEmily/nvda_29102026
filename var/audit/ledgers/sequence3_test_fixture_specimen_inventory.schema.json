{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sequence3_test_fixture_specimen_inventory.schema.json",
  "title": "Sequence 3 test fixture/specimen inventory ledger",
  "type": "object",
  "required": [
    "schema_version",
    "sequence",
    "result",
    "source_lock",
    "read_transcript_summary",
    "record_count_assertions",
    "slice_count_assertions",
    "sequence2_vocabulary_reconciliation",
    "disposition_counts",
    "runtime_implementation_opened",
    "sequence4_readiness_flag",
    "blockers",
    "per_record_fixture_specimen_dispositions"
  ],
  "properties": {
    "schema_version": {
      "const": "sequence3_test_fixture_specimen_inventory.v1"
    },
    "sequence": {
      "const": "Sequence 3"
    },
    "result": {
      "enum": [
        "PASS",
        "HOLD_VOCABULARY_ADMISSION_REQUIRED",
        "HOLD_RUNTIME_SUPPORT_SURFACE_REQUIRED",
        "HOLD_SEQUENCE4_REQUIRED_FOR_PACKET_SEAM",
        "FAIL_SCOPE_BREACH",
        "FAIL_PROOF_INCONSISTENT"
      ]
    },
    "source_lock": {
      "type": "object",
      "required": [
        "path",
        "expected_sha256",
        "actual_sha256",
        "expected_size_bytes",
        "actual_size_bytes",
        "verified"
      ]
    },
    "read_transcript_summary": {
      "type": "object"
    },
    "record_count_assertions": {
      "type": "object"
    },
    "slice_count_assertions": {
      "type": "object"
    },
    "sequence2_vocabulary_reconciliation": {
      "type": "object"
    },
    "disposition_counts": {
      "type": "object"
    },
    "runtime_implementation_opened": {
      "type": "boolean"
    },
    "sequence4_readiness_flag": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array"
    },
    "per_record_fixture_specimen_dispositions": {
      "type": "array",
      "minItems": 1716,
      "maxItems": 1716,
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "stable_record_key",
          "source_slice_filename",
          "required_proof_tier",
          "sequence3_disposition",
          "retained_test_registry_posture",
          "proof_block_posture",
          "vocabulary_consistency_posture",
          "runtime_implementation_opened"
        ],
        "properties": {
          "sequence3_disposition": {
            "enum": [
              "existing_fixture_home_sufficient",
              "existing_specimen_home_sufficient",
              "new_fixture_home_created",
              "new_expected_packet_specimen_created",
              "retained_test_registry_entry_added",
              "proof_block_entry_added",
              "fixture_wording_conformed",
              "future_fixture_required_before_implementation",
              "future_packet_specimen_required_in_sequence4",
              "no_fixture_required_for_record",
              "blocked_requires_vocabulary_admission",
              "blocked_requires_runtime_support_surface",
              "blocked_missing_authority_file"
            ]
          },
          "runtime_implementation_opened": {
            "const": false
          }
        }
      }
    }
  }
}
