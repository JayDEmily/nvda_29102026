+def test_fwd011_reopened_rows_have_real_playbook_library_authority_behaviour(
+    audit_row_id: str, atlas_record_id: str, behaviour: str, tmp_path: Path
+) -> None:
+    assert audit_row_id.startswith("FWD011-AUDIT-")
+    assert atlas_record_id.startswith("atlas_donor_")
+    registry = _registry()
+
+    if behaviour == "registry_document_contract":
+        assert registry.schema_version == "playbook_registry.v1"
+        assert registry.registry_id == "fwd011-registry"
+        assert [playbook.playbook_id for playbook in registry.enabled_playbooks()] == [
+            "gap_up_follow_through",
+            "breakdown_reversal",
+        ]
+        exported = registry.enabled_playbooks()[0].model_dump()
+        exported["selection_metadata"]["setup_family"] = "mutated"
+        assert registry.playbooks[0].selection_metadata["setup_family"] == "gap_up"
+        return
+
+    if behaviour == "registry_uniqueness":
+        with pytest.raises(ValidationError, match="duplicate playbook_id"):
+            PlaybookRegistryDocument(
+                registry_id="fwd011-registry",
+                playbooks=(
+                    PlaybookDefinition(
+                        playbook_id="gap_up_follow_through",
+                        setup_family="gap_up",
+                        setup_variant_ids=("gap_up.baseline",),
+                    ),
+                    PlaybookDefinition(
+                        playbook_id="gap_up_follow_through",
+                        setup_family="gap_up",
+                        setup_variant_ids=("gap_up.risk_defined",),
+                    ),
+                ),
+            )
+        with pytest.raises(ValidationError, match="duplicate setup_variant_id"):
+            PlaybookDefinition(
+                playbook_id="gap_up_follow_through",
+                setup_family="gap_up",
+                setup_variant_ids=("gap_up.baseline", "gap_up.baseline"),
+            )
+        return
+
+    if behaviour == "deterministic_receipt_order":
+        receipts = build_playbook_metadata_receipts(registry)
+        assert [receipt.receipt_id for receipt in receipts] == [
+            "fwd011-registry:gap_up_follow_through:gap_up.baseline",
+            "fwd011-registry:gap_up_follow_through:gap_up.risk_defined",
+            "fwd011-registry:breakdown_reversal:breakdown.baseline",
+        ]
+        assert {receipt.source_registry_fingerprint for receipt in receipts} == {registry.fingerprint()}
+        copied = receipts[0].model_copy(deep=True)
+        copied.selection_metadata["setup_family"] = "mutated"
+        assert receipts[0].selection_metadata["setup_family"] == "gap_up"
+        return
+
+    if behaviour == "variant_lookup_filter":
+        receipts = build_playbook_metadata_receipts(
+            registry,
+            setup_variant_ids=("gap_up.risk_defined", "breakdown.baseline"),
+        )
+        assert [receipt.setup_variant_id for receipt in receipts] == [
+            "gap_up.risk_defined",
+            "breakdown.baseline",
+        ]
+        assert [receipt.playbook_id for receipt in receipts] == [
+            "gap_up_follow_through",
+            "breakdown_reversal",
+        ]
+        return
+
+    if behaviour == "family_lookup_filter":
+        receipts = build_playbook_metadata_receipts(registry, setup_family_ids=("gap_up",))
+        assert [receipt.playbook_id for receipt in receipts] == [
+            "gap_up_follow_through",
+            "gap_up_follow_through",
+        ]
+        assert [receipt.setup_family for receipt in receipts] == ["gap_up", "gap_up"]
+        assert [receipt.setup_variant_id for receipt in receipts] == [
+            "gap_up.baseline",
+            "gap_up.risk_defined",
+        ]
+        return
+
+    if behaviour == "yaml_loader_contract":
+        registry_path = tmp_path / f"{audit_row_id}.yaml"
+        _write_registry_yaml(registry_path)
+        loaded = load_playbook_registry(registry_path)
+        assert loaded.registry_id == "fwd011-yaml"
+        assert [playbook.playbook_id for playbook in loaded.enabled_playbooks()] == [
+            "gap_up_follow_through",
+            "breakdown_reversal",
+        ]
+        duplicate_path = tmp_path / f"{audit_row_id}-duplicate.yaml"
