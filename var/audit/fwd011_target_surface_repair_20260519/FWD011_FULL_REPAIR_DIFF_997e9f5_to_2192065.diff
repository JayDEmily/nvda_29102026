+
+    if behaviour == "eligibility_output_contract":
+        output = compile_playbook_eligibility(
+            permission_state=PermissionState.ALLOW,
+            registry=registry,
+            candidate_family_ids=["breakdown"],
+        )
+        dumped = output.model_dump()
+        assert set(dumped) == {
