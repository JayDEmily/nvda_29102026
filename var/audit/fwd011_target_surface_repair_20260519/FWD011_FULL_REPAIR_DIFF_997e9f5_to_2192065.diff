+            "active_family_ids",
+            "active_setup_variant_ids",
+            "registry_id",
+            "playbook_metadata_receipts",
+        }
+        assert output.active_setup_variant_ids == ["breakdown.baseline"]
+        assert "broker_order" not in str(dumped)
+        assert "authorised_notional_usd" not in str(dumped)
+        return
+
+    if behaviour == "admissibility_surface":
+        surface = EligibilityAdmissibilitySurface(
+            permission_state=PermissionState.BLOCK,
+            no_trade_reasons=["permission_block"],
+        )
+        assert surface.permission_state == PermissionState.BLOCK
+        assert surface.no_trade_reasons == ["permission_block"]
+        assert set(EligibilityAdmissibilitySurface.model_fields) == {
+            "permission_state",
+            "no_trade_reasons",
+        }
+        return
+
+    if behaviour == "permission_block_reason":
+        output = compile_playbook_eligibility(
+            permission_state=PermissionState.BLOCK,
+            registry=registry,
+            candidate_family_ids=["gap_up", "breakdown"],
+        )
+        assert output.active_family_ids == []
+        assert output.active_setup_variant_ids == []
+        assert output.playbook_metadata_receipts == []
+        assert output.registry_id == "fwd011-registry"
+        assert output.admissibility_surface.no_trade_reasons == ["permission_block"]
+        return
+
+    if behaviour == "capital_authority_fence":
+        for authority_key in (
+            "capital_deployment",
+            "broker_order",
+            "live_order_execution",
+            "execution_expression_service",
+        ):
+            with pytest.raises(ValueError, match="hidden playbook authority key rejected"):
+                reject_hidden_playbook_authority(_hidden_payload(atlas_record_id, authority_key))
