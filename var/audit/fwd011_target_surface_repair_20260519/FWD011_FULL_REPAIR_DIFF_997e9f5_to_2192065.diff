+            PlaybookDefinition(
+                playbook_id="gap_up_follow_through",
+                setup_family="gap_up",
+                setup_variant_ids=("gap_up.baseline",),
+                selection_metadata=_hidden_payload(atlas_record_id, "capital_deployment"),
+            )
+        return
+
+    if behaviour == "service_module_fence":
+        assert PlaybookEligibilityService().evaluate(
+            posture=PostureRiskOutput(permission_state=PermissionState.ALLOW),
+            registry=registry,
+            candidate_family_ids=["breakdown"],
+        ).active_setup_variant_ids == ["breakdown.baseline"]
+        assert "PlaybookRegistryService" not in set().union(
+            *(_defined_symbols(path) for path in SELECTED_NATIVE_FILES)
+        )
+        return
+
+    if behaviour == "native_transform_boundary":
+        for path in SELECTED_NATIVE_FILES:
+            imports = _imports_for(path)
+            assert not {
+                module for module in imports if module.startswith(PROHIBITED_IMPORT_PREFIXES)
+            }, path
+        defined_symbols: set[str] = set()
+        for path in SELECTED_NATIVE_FILES:
+            defined_symbols.update(_defined_symbols(path))
+        assert defined_symbols.isdisjoint(PROHIBITED_DONOR_SYMBOLS)
+        donor_key = next(iter(PLAYBOOK_FORBIDDEN_AUTHORITY_KEYS))
+        with pytest.raises(ValueError, match="hidden playbook authority key rejected"):
+            reject_hidden_playbook_authority(_hidden_payload(atlas_record_id, donor_key))
+        return
