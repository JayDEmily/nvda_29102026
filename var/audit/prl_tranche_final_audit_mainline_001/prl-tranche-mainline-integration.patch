++
++def event_proximity_entries_from_calendar_snapshot(
++    snapshot: RuntimeCalendarSnapshot,
++) -> list[EventProximityRegisterEntry]:
++    """Return descriptive event proximity entries from a context-only calendar snapshot."""
++
++    entries: list[EventProximityRegisterEntry] = []
++    for match in snapshot.matches:
++        event = match.event
++        tags = sorted(event.tags)
++        entries.append(
++            EventProximityRegisterEntry(
++                event_id=event.event_id,
++                event_type=event.event_type,
++                starts_at_utc=event.starts_at,
++                ends_at_utc=event.ends_at,
++                proximity_seconds=match.proximity_seconds,
++                materiality=event.materiality,
++                materiality_rank=match.materiality_rank,
++                runtime_tags=tags,
++                evaluation_tags=tags,
++                risk_interpretation="event_proximity_state_of_play_only",
++                source_refs=list(event.lineage_ids),
++            )
++        )
++    return entries
+diff --git a/src/nvda_desk/domain/parallel_risk/family_aggregation.py b/src/nvda_desk/domain/parallel_risk/family_aggregation.py
+new file mode 100644
+index 0000000..6b095a8
+--- /dev/null
++++ b/src/nvda_desk/domain/parallel_risk/family_aggregation.py
+@@ -0,0 +1,53 @@
++"""Risk-family aggregation for supported Parallel Risk Lane atoms."""
++
++from __future__ import annotations
++
++from collections import defaultdict
++
++from nvda_desk.contracts.parallel_risk import ParallelRiskAtomStateValue, RiskAtomState, RiskFamilyState
++
++_STATE_RANK: dict[ParallelRiskAtomStateValue, int] = {
++    "inactive": 0,
++    "observe": 1,
++    "caution": 2,
++    "block": 3,
++}
++
++
++def aggregate_risk_family_states(atoms: list[RiskAtomState]) -> list[RiskFamilyState]:
++    """Aggregate atom states into family-level descriptive state.
++
++    The output is a state-of-play summary only; it carries no capital, playbook, or order
++    authority.
++    """
++
++    grouped: dict[str, list[RiskAtomState]] = defaultdict(list)
++    for atom in atoms:
++        grouped[atom.family].append(atom)
++
++    families: list[RiskFamilyState] = []
++    for family, family_atoms in sorted(grouped.items()):
++        highest_rank = max(_STATE_RANK[atom.state] for atom in family_atoms)
++        state = next(key for key, rank in _STATE_RANK.items() if rank == highest_rank)
++        max_intensity = max(atom.intensity for atom in family_atoms)
++        confidence = min(atom.confidence for atom in family_atoms)
++        dominant_atoms = sorted(
++            atom.risk_atom_id
++            for atom in family_atoms
++            if _STATE_RANK[atom.state] == highest_rank and atom.intensity == max_intensity
++        )
++        if not dominant_atoms:
++            dominant_atoms = sorted(
++                atom.risk_atom_id for atom in family_atoms if _STATE_RANK[atom.state] == highest_rank
++            )
++        families.append(
++            RiskFamilyState(
++                family=family,
++                state=state,
++                intensity=max_intensity,
++                confidence=confidence,
++                dominant_atoms=dominant_atoms,
++                notes=["state_of_play_aggregation_only"],
++            )
++        )
++    return families
+diff --git a/src/nvda_desk/domain/parallel_risk/freshness.py b/src/nvda_desk/domain/parallel_risk/freshness.py
+new file mode 100644
+index 0000000..49fc7f4
+--- /dev/null
++++ b/src/nvda_desk/domain/parallel_risk/freshness.py
+@@ -0,0 +1,77 @@
++"""Deterministic source freshness helpers for the Parallel Risk Lane.
++
++Freshness is a neutral state-of-play input. A stale source does not imply a trade action;
++it lowers confidence in the current environmental read until downstream authority decides how
++or whether to use that information.
++"""
++
++from __future__ import annotations
++
++from datetime import UTC, datetime
++
++from nvda_desk.contracts.parallel_risk import FreshnessRegisterEntry, ParallelRiskFreshnessState
++
++DEFAULT_MAX_ALLOWED_AGE_SECONDS = 60
++
++
++def build_freshness_register_entry(
++    *,
++    signal_id: str,
++    source_time_utc: datetime | None = None,
++    captured_at_utc: datetime | None = None,
++    persisted_at_utc: datetime | None = None,
++    generated_at_utc: datetime | None = None,
++    max_allowed_age_seconds: int = DEFAULT_MAX_ALLOWED_AGE_SECONDS,
++    source_refs: list[str] | None = None,
++) -> FreshnessRegisterEntry:
++    """Return a deterministic freshness register entry without config or workbook reads."""
++
++    observed_age_seconds: int | None = None
++    if source_time_utc is not None and generated_at_utc is not None:
++        observed_age_seconds = max(
++            0, int((_utc_compatible(generated_at_utc) - _utc_compatible(source_time_utc)).total_seconds())
++        )
++
++    state = _classify_freshness(
++        observed_age_seconds=observed_age_seconds,
++        max_allowed_age_seconds=max_allowed_age_seconds,
++    )
++    return FreshnessRegisterEntry(
++        signal_id=signal_id,
++        source_time_utc=source_time_utc,
++        captured_at_utc=captured_at_utc,
++        persisted_at_utc=persisted_at_utc,
++        generated_at_utc=generated_at_utc,
++        max_allowed_age_seconds=max_allowed_age_seconds,
++        observed_age_seconds=observed_age_seconds,
++        freshness_state=state,
++        impact_on_profile=_impact_for_state(state),
++        source_refs=list(source_refs or []),
++    )
++
++
++def _classify_freshness(
++    *, observed_age_seconds: int | None, max_allowed_age_seconds: int
++) -> ParallelRiskFreshnessState:
++    if observed_age_seconds is None:
++        return "unknown"
++    if observed_age_seconds <= max_allowed_age_seconds:
++        return "fresh"
++    if observed_age_seconds <= max_allowed_age_seconds * 2:
++        return "ageing"
++    return "stale"
++
++
++def _impact_for_state(state: ParallelRiskFreshnessState) -> str:
++    return {
++        "fresh": "freshness_supports_current_state_read",
++        "ageing": "freshness_ageing_uncertainty_contribution",
++        "stale": "freshness_stale_uncertainty_contribution",
++        "unknown": "freshness_unknown_state_of_play",
++    }[state]
++
++
++def _utc_compatible(value: datetime) -> datetime:
++    if value.tzinfo is None:
++        return value.replace(tzinfo=UTC)
++    return value.astimezone(UTC)
+diff --git a/src/nvda_desk/domain/parallel_risk/minute_profile_assembly.py b/src/nvda_desk/domain/parallel_risk/minute_profile_assembly.py
