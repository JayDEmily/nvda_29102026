@@ -0,0 +1,74 @@
+"""Missing/quarantined signal helpers for the Parallel Risk Lane.
+
+These helpers describe input availability and confidence, not a trading posture.
+"""
+
+from __future__ import annotations
+
+from typing import Literal
+
+from nvda_desk.contracts.parallel_risk import MissingSignalRegisterEntry, SignalSnapshotEntry
+from nvda_desk.contracts.upstream_signal import UpstreamIngressResult
+
+
+def build_missing_signal_register_entry(
+    *,
+    signal_id: str,
+    signal_family: str,
+    expected_reason: str,
+    missing_reason: str,
+    impact_on_profile: Literal[
+        "none", "lowers_confidence", "disables_atom", "forces_caution", "forces_block"
+    ] = "lowers_confidence",
+    source_refs: list[str] | None = None,
+    expected_signal_inventory_ref: str | None = None,
+    workbook_lineage_refs: list[str] | None = None,
+) -> MissingSignalRegisterEntry:
+    """Return one metadata-only missing-signal register entry."""
+
+    return MissingSignalRegisterEntry(
+        signal_id=signal_id,
+        signal_family=signal_family,
+        expected_reason=expected_reason,
+        missing_reason=missing_reason,
+        impact_on_profile=impact_on_profile,
+        source_refs=list(source_refs or []),
+        expected_signal_inventory_ref=expected_signal_inventory_ref,
+        workbook_lineage_refs=list(workbook_lineage_refs or []),
+    )
+
+
+def signal_snapshot_from_upstream_ingress_result(
+    result: UpstreamIngressResult, *, raw_or_derived: Literal["raw", "derived", "metadata", "config", "trace"]
+) -> SignalSnapshotEntry:
+    """Project one upstream ingress result into a PRL signal snapshot entry.
+
+    Rejected/quarantined values remain unavailable to the PRL; admitted trace-only payloads
+    keep trace value and lineage without opening decision authority.
+    """
+
+    trace = result.sanity_trace
+    if result.quarantined:
+        return SignalSnapshotEntry(
+            signal_id=trace.signal_family_id,
+            signal_family=trace.signal_family_id,
+            raw_or_derived=raw_or_derived,
+            value=None,
+            missing_or_quarantined="quarantined",
+            rejection_reason=trace.rejection_reason,
+            source_ids=[trace.source_id],
+            lawful_prl_use_allowed=False,
+            lawful_prl_use_reason="upstream_signal_quarantined_not_available_to_prl",
+        )
+
+    return SignalSnapshotEntry(
+        signal_id=trace.signal_family_id,
+        signal_family=trace.signal_family_id,
+        raw_or_derived=raw_or_derived,
+        value=result.trace_envelope.get("payload", {}),
+        missing_or_quarantined="present",
+        source_ids=[trace.source_id],
+        lineage_refs=[trace.scope_id],
+        lawful_prl_use_allowed=True,
+        lawful_prl_use_reason="admitted_trace_only_signal_snapshot",
+    )
diff --git a/src/nvda_desk/domain/parallel_risk/risk_atoms.py b/src/nvda_desk/domain/parallel_risk/risk_atoms.py
new file mode 100644
index 0000000..0bb17a8
--- /dev/null
+++ b/src/nvda_desk/domain/parallel_risk/risk_atoms.py
@@ -0,0 +1,123 @@
+"""Supported risk atom construction for currently available PRL inputs.
+
+Risk atoms describe the market state-of-play. They can carry constructive, defensive,
+ambiguous, mixed, uncertainty, and consequence semantics without issuing trade advice.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime
+
+from nvda_desk.contracts.parallel_risk import (
+    EventProximityRegisterEntry,
+    FreshnessRegisterEntry,
+    MissingSignalRegisterEntry,
+    ParallelRiskAtomStateValue,
+    ParallelRiskEnvelope,
+    RiskAtomState,
+)
+
+
+def build_supported_risk_atoms(
+    *,
+    freshness_entries: list[FreshnessRegisterEntry],
+    missing_signal_entries: list[MissingSignalRegisterEntry],
+    event_proximity_entries: list[EventProximityRegisterEntry],
+    envelope: ParallelRiskEnvelope,
+    generated_at_utc: datetime | None = None,
+) -> list[RiskAtomState]:
+    """Build risk atoms from the currently lawful PRL signal surface."""
+
+    atoms: list[RiskAtomState] = []
+    atoms.extend(_freshness_atom(entry) for entry in freshness_entries)
+    atoms.extend(_missing_signal_atom(entry) for entry in missing_signal_entries)
+    atoms.extend(_event_atom(entry) for entry in event_proximity_entries)
+    atoms.extend(_envelope_atoms(envelope))
+    return atoms
+
+
+def _freshness_atom(entry: FreshnessRegisterEntry) -> RiskAtomState:
+    state: ParallelRiskAtomStateValue = "observe" if entry.freshness_state != "stale" else "caution"
+    risk_side = "constructive" if entry.freshness_state == "fresh" else "uncertainty"
+    confidence = 0.9 if entry.freshness_state == "fresh" else 0.45 if entry.freshness_state == "unknown" else 0.6
+    return RiskAtomState(
+        risk_atom_id=f"freshness:{entry.signal_id}",
+        name="source_freshness_state",
+        family="operational_tooling",
+        state=state,
+        intensity=0.2 if entry.freshness_state == "fresh" else 0.6,
+        confidence=confidence,
+        trigger_condition=f"freshness_state={entry.freshness_state}",
+        observable_cues=[entry.model_dump(mode="json")],
+        calculation_basis={"method_id": "freshness_register_v1", "risk_side": risk_side},
+        source_refs=list(entry.source_refs),
+        time_sensitivity={"session_phase_sensitive": False},
+        trader_cognition_update={"uncertainty_side": [entry.impact_on_profile or "freshness_state"]},
+        why_this_is_risk_not_play="Freshness describes reliability of the state read, not a trade action.",
+    )
+
+
+def _missing_signal_atom(entry: MissingSignalRegisterEntry) -> RiskAtomState:
+    return RiskAtomState(
+        risk_atom_id=f"signal_availability:{entry.signal_id}",
+        name="signal_availability_state",
+        family=entry.signal_family,
+        state="observe",
+        intensity=0.45 if entry.impact_on_profile == "lowers_confidence" else 0.2,
+        confidence=0.7,
+        trigger_condition=entry.missing_reason,
+        observable_cues=[entry.model_dump(mode="json")],
+        calculation_basis={"method_id": "missing_signal_register_v1", "risk_side": "uncertainty"},
+        source_refs=list(entry.source_refs),
+        time_sensitivity={"session_phase_sensitive": False},
+        trader_cognition_update={"uncertainty_side": [entry.missing_reason]},
+        why_this_is_risk_not_play="Signal availability changes confidence and uncertainty only; it does not choose a response.",
+    )
+
+
+def _event_atom(entry: EventProximityRegisterEntry) -> RiskAtomState:
+    active_tag = "scheduled_event_window_active" in set(entry.runtime_tags)
+    return RiskAtomState(
+        risk_atom_id=f"event_proximity:{entry.event_id}",
+        name="event_proximity_state",
+        family="calendar_event",
+        state="caution" if active_tag else "observe",
+        intensity=0.7 if active_tag else 0.35,
+        confidence=0.8,
+        trigger_condition=entry.risk_interpretation,
+        observable_cues=[entry.model_dump(mode="json")],
+        calculation_basis={"method_id": "event_proximity_register_v1", "risk_side": "mixed"},
+        source_refs=list(entry.source_refs),
+        time_sensitivity={"event_window_sensitive": True},
+        trader_cognition_update={"consequence_side": [entry.event_type], "uncertainty_side": entry.runtime_tags},
+        why_this_is_risk_not_play="Event proximity describes timing and consequence context, not a trading instruction.",
+    )
+
+
+def _envelope_atoms(envelope: ParallelRiskEnvelope) -> list[RiskAtomState]:
+    atoms: list[RiskAtomState] = []
+    for contribution in envelope.contributions:
+        atoms.append(
+            RiskAtomState(
+                risk_atom_id=f"envelope:{contribution.source_family}:{contribution.reason}",
+                name="legacy_envelope_contribution_state",
+                family=contribution.source_family,
+                state=_coerce_atom_state(contribution.state),
+                intensity=0.75 if contribution.state in {"caution", "block"} else 0.35,
+                confidence=0.75,
+                trigger_condition=contribution.reason,
+                observable_cues=[contribution.model_dump(mode="json")],
+                calculation_basis={"method_id": "legacy_envelope_contribution_v1", "risk_side": "mixed"},
+                source_refs=[],
+                time_sensitivity={"session_phase_sensitive": False},
+                trader_cognition_update={"state_of_play": [contribution.reason]},
+                why_this_is_risk_not_play="Envelope contribution describes current environmental state and carries no execution authority.",
+            )
+        )
+    return atoms
+
+
+def _coerce_atom_state(state: str) -> ParallelRiskAtomStateValue:
+    if state in {"inactive", "observe", "caution", "block"}:
+        return state  # type: ignore[return-value]
+    return "observe"
diff --git a/src/nvda_desk/domain/parallel_risk/unavailable_signals.py b/src/nvda_desk/domain/parallel_risk/unavailable_signals.py
new file mode 100644
index 0000000..12dd42d
--- /dev/null
+++ b/src/nvda_desk/domain/parallel_risk/unavailable_signals.py
@@ -0,0 +1,219 @@
+"""Unavailable-signal helpers for PRL signal inventory integration.
+
+Unavailable signals are explicit state-of-play metadata. They prevent hallucinated market
+context until a lawful typed source exists.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from nvda_desk.contracts.parallel_risk import (
+    MissingSignalRegisterEntry,
+    ParallelRiskExpectedSignalRecord,
+    ParallelRiskSignalInventoryDocument,
+    SignalSnapshotEntry,
+)
+
+InventoryPresenceState = Literal[
+    "present",
+    "missing",
+    "unavailable",
+    "deferred",
+    "excluded",
+    "quarantined",
+    "rejected",
+]
+
+
+@dataclass(frozen=True)
+class InventoryBackedUnavailableSignals:
+    """Unavailable-signal projection derived from the typed PRL inventory."""
+
+    signal_snapshot: list[SignalSnapshotEntry]
+    missing_signal_register: list[MissingSignalRegisterEntry]
+    presence_by_signal_id: dict[str, InventoryPresenceState]
+    open_unresolved_signals: list[dict[str, str]]
+
+
+def build_unavailable_signal_snapshot_entry(
+    *,
+    signal_id: str,
+    signal_family: str,
+    reason: str,
+    expected_signal_inventory_ref: str | None = None,
+    workbook_lineage_refs: list[str] | None = None,
+    source_refs: list[str] | None = None,
+) -> SignalSnapshotEntry:
+    """Return a snapshot entry for a known-but-unavailable signal without a value."""
+
+    return SignalSnapshotEntry(
+        signal_id=signal_id,
+        signal_family=signal_family,
+        raw_or_derived="metadata",
+        value=None,
+        freshness_state="unknown",
+        freshness_reason=reason,
+        lineage_refs=list(source_refs or []),
+        workbook_lineage_refs=list(workbook_lineage_refs or []),
+        missing_or_quarantined="missing",
+        lawful_prl_use_allowed=False,
+        lawful_prl_use_reason="typed_runtime_signal_unavailable",
+    )
+
+
+def build_unavailable_signal_watch_entry(
+    *,
+    signal_id: str,
+    signal_family: str,
+    reason: str,
+    expected_signal_inventory_ref: str | None = None,
+    workbook_lineage_refs: list[str] | None = None,
+    source_refs: list[str] | None = None,
+) -> MissingSignalRegisterEntry:
+    """Return a register entry for a known unavailable signal family."""
+
+    return MissingSignalRegisterEntry(
+        signal_id=signal_id,
+        signal_family=signal_family,
+        expected_reason="expected_by_future_parallel_risk_lane_signal_inventory",
+        missing_reason=reason,
+        impact_on_profile="lowers_confidence",
+        source_refs=list(source_refs or []),
+        expected_signal_inventory_ref=expected_signal_inventory_ref,
+        workbook_lineage_refs=list(workbook_lineage_refs or []),
+    )
+
+
+def build_inventory_backed_unavailable_signals(
+    *,
+    inventory: ParallelRiskSignalInventoryDocument,
+    present_signal_ids: set[str] | frozenset[str],
+    quarantined_signal_ids: set[str] | frozenset[str] | None = None,
+    rejected_signal_ids: set[str] | frozenset[str] | None = None,
+    source_refs: list[str] | None = None,
+) -> InventoryBackedUnavailableSignals:
+    """Project inventory availability into snapshot/register metadata without fake values."""
+
+    present = set(present_signal_ids)
+    quarantined = set(quarantined_signal_ids or set())
+    rejected = set(rejected_signal_ids or set())
+    refs = list(source_refs or [])
+    snapshots: list[SignalSnapshotEntry] = []
+    register: list[MissingSignalRegisterEntry] = []
+    presence: dict[str, InventoryPresenceState] = {}
+    unresolved: list[dict[str, str]] = []
+
+    for record in inventory.records:
+        if record.inventory_status == "excluded":
+            presence[record.signal_id] = "excluded"
+            continue
+        if record.signal_id in rejected:
+            state: InventoryPresenceState = "rejected"
+            reason = "upstream_signal_rejected_not_available_to_prl"
+            impact = "lowers_confidence"
+        elif record.signal_id in quarantined:
+            state = "quarantined"
+            reason = "upstream_signal_quarantined_not_available_to_prl"
+            impact = "lowers_confidence"
+        elif record.signal_id in present:
+            presence[record.signal_id] = "present"
+            continue
+        elif record.inventory_status == "available_now" and record.required_for_current_atom:
+            state = "missing"
+            reason = record.missing_handling
+            impact = _impact_from_policy(record.missing_handling)
+        elif record.inventory_status == "deferred":
+            state = "deferred"
+            reason = record.unavailable_handling
+            impact = _impact_from_policy(record.missing_handling)
+        else:
+            state = "unavailable"
+            reason = record.unavailable_handling
+            impact = _impact_from_policy(record.missing_handling)
+
+        presence[record.signal_id] = state
+        snapshot = _snapshot_from_inventory_record(
+            record=record,
+            state=state,
+            reason=reason,
+            source_refs=refs,
+        )
+        snapshots.append(snapshot)
+        register.append(
+            MissingSignalRegisterEntry(
+                signal_id=record.signal_id,
+                signal_family=record.signal_family,
+                expected_reason="expected_by_parallel_risk_signal_inventory",
+                missing_reason=reason,
+                impact_on_profile=impact,
+                source_refs=refs,
+                expected_signal_inventory_ref=f"{inventory.inventory_id}#{record.promotion_record_key}",
+                workbook_lineage_refs=list(record.workbook_lineage_refs),
+            )
+        )
+        unresolved.append(
+            {
+                "signal_id": record.signal_id,
+                "signal_family": record.signal_family,
+                "inventory_status": record.inventory_status,
+                "presence_state": state,
+                "handling_policy": reason,
+            }
+        )
+
+    return InventoryBackedUnavailableSignals(
+        signal_snapshot=snapshots,
+        missing_signal_register=register,
+        presence_by_signal_id=presence,
+        open_unresolved_signals=unresolved,
+    )
+
+
+def _snapshot_from_inventory_record(
+    *,
+    record: ParallelRiskExpectedSignalRecord,
+    state: InventoryPresenceState,
+    reason: str,
+    source_refs: list[str],
+) -> SignalSnapshotEntry:
+    return SignalSnapshotEntry(
+        signal_id=record.signal_id,
+        signal_family=record.signal_family,
+        raw_or_derived=_signal_kind(record.raw_derived_config_trace_classification),
+        value=None,
+        freshness_state="unknown",
+        freshness_reason=reason,
+        lineage_refs=list(source_refs),
+        workbook_lineage_refs=list(record.workbook_lineage_refs),
+        missing_or_quarantined=state,
+        lawful_prl_use_allowed=False,
+        lawful_prl_use_reason="typed_inventory_signal_not_available_to_prl_runtime",
+    )
+
+
+def _impact_from_policy(policy: str) -> Literal[
+    "none", "lowers_confidence", "disables_atom", "forces_caution", "forces_block"
+]:
+    if "forces_block" in policy:
+        return "forces_block"
+    if "forces_caution" in policy:
+        return "forces_caution"
+    if "disables_atom" in policy:
+        return "disables_atom"
+    if "lowers_confidence" in policy or "no_value" in policy:
+        return "lowers_confidence"
+    return "none"
+
+
+def _signal_kind(classification: str) -> Literal["raw", "derived", "metadata", "config", "trace"]:
+    if "trace" in classification or "upstream_packet" in classification:
+        return "trace"
+    if "config" in classification:
+        return "config"
+    if "derived" in classification:
+        return "derived"
+    if "raw" in classification:
+        return "raw"
+    return "metadata"
