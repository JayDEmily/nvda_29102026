{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "protocols": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^P(?:0[0-9]|[1-9][0-9]+)$",
            "type": "string"
          },
          "name": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "predecessors": {
            "default": [],
            "items": {
              "type": "string",
              "pattern": "^[MPGAKS](?:0[0-9]|[1-9][0-9]+)$"
            },
            "type": "array",
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "placeholder",
              "bootstrap",
              "framework",
              "active",
              "deprecated",
              "retired"
            ],
            "type": "string"
          },
          "successors": {
            "default": [],
            "items": {
              "type": "string",
              "pattern": "^[MPGAKS](?:0[0-9]|[1-9][0-9]+)$"
            },
            "type": "array",
            "uniqueItems": true
          },
          "package": {
            "pattern": "^nvda_desk\\.[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "public_seam": {
            "pattern": "^nvda_desk\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)?$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "description"
        ],
        "type": "object",
        "allOf": [
          {
            "if": {
              "required": [
                "package"
              ]
            },
            "then": {
              "required": [
                "public_seam"
              ]
            }
          },
          {
            "if": {
              "required": [
                "public_seam"
              ]
            },
            "then": {
              "required": [
                "package"
              ]
            }
          }
        ]
      },
      "type": "array"
    },
    "retired_ids": {
      "items": {
        "pattern": "^P(?:0[0-9]|[1-9][0-9]+)$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "schema_version",
    "protocols",
    "retired_ids"
  ],
  "type": "object"
}
