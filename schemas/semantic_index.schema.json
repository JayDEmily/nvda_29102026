{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticIndex",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["PENDING", "ACCEPTED"]},
    "admission_id": {"type": ["string", "null"]},
    "note": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entry_id": {"type": "string", "minLength": 1},
          "proposition": {"type": "string", "minLength": 1},
          "authority_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "required": ["path", "sha256"]
            }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "required": ["entry_id", "proposition", "authority_refs", "dependencies"]
      }
    }
  },
  "required": ["schema_version", "status", "admission_id", "note", "entries"],
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ACCEPTED"}}},
      "then": {"properties": {"admission_id": {"type": "string", "minLength": 1}}}
    }
  ]
}
