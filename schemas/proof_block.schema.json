{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "proof_blocks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "family_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "lifecycle": {
            "enum": [
              "current_blocking",
              "current_nonblocking",
              "historical"
            ]
          },
          "tier": {
            "enum": [
              "Tier A",
              "Tier B",
              "Tier C"
            ]
          }
        },
        "required": [
          "id",
          "tier",
          "lifecycle",
          "family_ids"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "schema_version",
    "proof_blocks"
  ],
  "type": "object"
}
