{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_id": {
      "minLength": 1,
      "type": "string"
    },
    "admitted_at_utc": {
      "minLength": 1,
      "type": "string"
    },
    "disposition": {
      "const": "GATE0_PASS"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "guarded_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "proposition_id": {
      "const": "GATE0_MINIMAL_RUNTIME_ADMISSION_V1"
    },
    "proven_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "run_nonce": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "admission_id",
    "proposition_id",
    "run_nonce",
    "proven_commit",
    "manifest_sha256",
    "guarded_hashes",
    "evidence_sha256",
    "disposition",
    "admitted_at_utc"
  ],
  "title": "Gate0AdmissionRecord",
  "type": "object"
}
