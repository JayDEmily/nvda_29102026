{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "automatic_final_subagent_stop_closure": {
      "const": false
    },
    "closure_actor": {
      "const": "ordinary_wsl"
    },
    "forbidden_gate0_dependencies": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "guarded_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "immediate_roles": {
      "const": [
        "integration_auditor",
        "semantic_reviewer"
      ]
    },
    "pass_scope": {
      "minLength": 1,
      "type": "string"
    },
    "proposition_id": {
      "const": "GATE0_MINIMAL_RUNTIME_ADMISSION_V1"
    },
    "purpose": {
      "minLength": 1,
      "type": "string"
    },
    "required_live_sequence": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "runtime_policy": {
      "additionalProperties": false,
      "properties": {
        "agent_runtime_must_be_wsl": {
          "const": true
        },
        "approval_policy": {
          "const": "on-request"
        },
        "architecture": {
          "const": "x86_64"
        },
        "integrated_terminal_is_not_runtime_proof": {
          "const": true
        },
        "os": {
          "const": "linux"
        },
        "sandbox_mode": {
          "const": "read-only"
        },
        "wsl2_required": {
          "const": true
        }
      },
      "required": [
        "os",
        "architecture",
        "wsl2_required",
        "sandbox_mode",
        "approval_policy",
        "agent_runtime_must_be_wsl",
        "integrated_terminal_is_not_runtime_proof"
      ],
      "type": "object"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "proposition_id",
    "purpose",
    "hash_algorithm",
    "runtime_policy",
    "immediate_roles",
    "guarded_paths",
    "required_live_sequence",
    "closure_actor",
    "automatic_final_subagent_stop_closure",
    "forbidden_gate0_dependencies",
    "pass_scope"
  ],
  "title": "Gate0AdmissionManifest",
  "type": "object"
}
