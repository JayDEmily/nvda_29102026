{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "candidate_commit": {
          "type": "string"
        }
      }
    },
    {
      "properties": {
        "candidate_sha256": {
          "type": "string"
        }
      }
    }
  ],
  "properties": {
    "accepted_base_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "actor_id": {
      "minLength": 1,
      "type": "string"
    },
    "actor_role": {
      "minLength": 1,
      "type": "string"
    },
    "actor_runtime_ref": {
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "sha256"
      ],
      "type": "object"
    },
    "actor_thread_id": {
      "minLength": 1,
      "type": "string"
    },
    "actual_changed_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "attempt_id": {
      "minLength": 1,
      "type": "string"
    },
    "candidate_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "proof_results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          }
        },
        "required": [
          "command",
          "outcome",
          "evidence_sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "work_order_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "attempt_id",
    "work_order_id",
    "actor_id",
    "actor_role",
    "actor_thread_id",
    "actor_runtime_ref",
    "accepted_base_commit",
    "candidate_commit",
    "candidate_sha256",
    "actual_changed_paths",
    "proof_results"
  ],
  "title": "AttemptRecord",
  "type": "object"
}
