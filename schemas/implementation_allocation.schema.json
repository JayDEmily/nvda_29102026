{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "implementation_allocations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "implemented_on": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "type": "string"
          },
          "name": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "object_id": {
            "pattern": "^[MPGAKS](?:0[0-9]|[1-9][0-9]+)$",
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "name",
          "implemented_on"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "schema_version",
    "implementation_allocations"
  ],
  "type": "object"
}
