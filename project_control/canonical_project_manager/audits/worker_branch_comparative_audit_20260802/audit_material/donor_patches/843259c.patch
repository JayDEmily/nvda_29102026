         packet_id=packet_id,
+        dataset_id=dataset_id,
+        dataset_fingerprint=dataset_fingerprint,
         windows=(
             WalkForwardWindow("train", WalkForwardWindowRole.TRAIN, 0, third - 1),
             WalkForwardWindow("validation", WalkForwardWindowRole.VALIDATION, third, third * 2 - 1),
