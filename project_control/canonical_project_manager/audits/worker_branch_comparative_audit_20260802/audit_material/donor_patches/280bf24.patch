+from __future__ import annotations
+
+import ast
+import json
+from collections import defaultdict
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[4]
+SOURCE_ROOT = ROOT / "src"
+OUTPUT_ROOT = Path(__file__).resolve().parent
+
+ALLOWED_RUNTIME_DEPENDENCIES = {
+    "M01": set(),
+    "M02": {"M01"},
+    "M03": {"M01", "M02"},
+    "M04": set(),
+    "M05": {"M03", "M07", "M08"},
+    "M06": {"M03"},
+    "M07": set(),
+    "M08": set(),
+    "M09": {"M05", "M06", "M07"},
+    "M10": {"M09"},
+    "M11": {"M10"},
+    "M12": {"M04"},
+    "M13": set(),
+}
+M13_TRANSACTION_PARTICIPANTS = {"M01", "M02", "M06", "M09", "M10", "M11", "M12"}
+
+
+def top_package(module: str) -> str:
+    parts = module.split(".")
+    return ".".join(parts[:2]) if len(parts) >= 2 else module
+
+
+def module_id(package: str) -> str | None:
+    name = package.split(".")[-1]
+    if len(name) >= 3 and name[0] == "m" and name[1:3].isdigit():
+        return name[:3].upper()
+    return None
+
+
+def strongly_connected_components(nodes: list[str], adjacency: dict[str, set[str]]) -> list[list[str]]:
+    indexes: dict[str, int] = {}
+    lowlinks: dict[str, int] = {}
+    stack: list[str] = []
+    on_stack: set[str] = set()
+    components: list[list[str]] = []
+
+    def visit(node: str) -> None:
+        indexes[node] = lowlinks[node] = len(indexes)
+        stack.append(node)
+        on_stack.add(node)
+        for target in adjacency.get(node, set()):
+            if target not in indexes:
+                visit(target)
+                lowlinks[node] = min(lowlinks[node], lowlinks[target])
+            elif target in on_stack:
+                lowlinks[node] = min(lowlinks[node], indexes[target])
+        if lowlinks[node] == indexes[node]:
+            component: list[str] = []
+            while True:
+                target = stack.pop()
+                on_stack.remove(target)
+                component.append(target)
+                if target == node:
+                    break
+            if len(component) > 1 or node in adjacency.get(node, set()):
+                components.append(sorted(component))
+
+    for node in nodes:
+        if node not in indexes:
+            visit(node)
+    return sorted(components)
+
+
+def main() -> None:
+    module_files: dict[str, Path] = {}
+    for path in sorted(SOURCE_ROOT.rglob("*.py")):
+        parts = list(path.relative_to(SOURCE_ROOT).with_suffix("").parts)
+        if parts[-1] == "__init__":
+            parts.pop()
+        module_files[".".join(parts)] = path
+
+    edges: list[dict[str, object]] = []
+    syntax_errors: list[dict[str, object]] = []
+    for module, path in module_files.items():
+        try:
+            tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+        except SyntaxError as exc:
+            syntax_errors.append(
+                {"module": module, "path": str(path.relative_to(ROOT)), "line": exc.lineno, "message": exc.msg}
+            )
+            continue
+        package = module.rsplit(".", 1)[0] if "." in module else module
+        for node in ast.walk(tree):
+            targets: list[str] = []
+            if isinstance(node, ast.Import):
+                targets = [alias.name for alias in node.names]
+            elif isinstance(node, ast.ImportFrom):
+                target = node.module or ""
+                if node.level:
+                    base = package.split(".")
+                    if node.level > 1:
+                        base = base[: -(node.level - 1)]
+                    target = ".".join([*base, target] if target else base)
+                targets = [target]
+            for target in targets:
+                if target.startswith("nvda_desk"):
+                    edges.append(
+                        {
+                            "source": module,
+                            "target": target,
+                            "path": str(path.relative_to(ROOT)),
+                            "line": node.lineno,
+                        }
+                    )
+
+    package_edges: dict[tuple[str, str], list[dict[str, object]]] = defaultdict(list)
+    for edge in edges:
+        source = top_package(str(edge["source"]))
+        target = top_package(str(edge["target"]))
+        if source != target:
+            package_edges[(source, target)].append(edge)
+
+    nodes = sorted({package for pair in package_edges for package in pair})
+    adjacency = {node: set() for node in nodes}
+    for source, target in package_edges:
+        adjacency[source].add(target)
+    cycles = strongly_connected_components(nodes, adjacency)
+
+    runtime_violations: list[dict[str, object]] = []
+    transaction_participation: list[dict[str, object]] = []
+    for (source, target), evidence in sorted(package_edges.items()):
+        source_id = module_id(source)
+        target_id = module_id(target)
+        if not source_id or not target_id or source_id == target_id:
+            continue
+        if target_id in ALLOWED_RUNTIME_DEPENDENCIES.get(source_id, set()):
+            continue
+        item = {"source": source, "target": target, "evidence": evidence}
+        if target_id == "M13" and source_id in M13_TRANSACTION_PARTICIPANTS:
+            transaction_participation.append(item)
+        else:
+            runtime_violations.append(item)
+
+    cycle_edges = {
+        ",".join(component): [
+            edge
+            for (source, target), group in package_edges.items()
+            if source in component and target in component
+            for edge in group
+        ]
+        for component in cycles
+    }
+    output = {
+        "module_count": len(module_files),
+        "syntax_errors": syntax_errors,
+        "top_level_cycles": cycles,
+        "runtime_dependency_violations": runtime_violations,
+        "m13_transaction_participation": transaction_participation,
+        "cycle_edges": cycle_edges,
+        "package_edges": {f"{source}->{target}": group for (source, target), group in sorted(package_edges.items())},
+    }
+    (OUTPUT_ROOT / "AST_IMPORT_GRAPH_RESULTS_AFTER_REPAIR.json").write_text(
+        json.dumps(output, indent=2, sort_keys=True), encoding="utf-8"
+    )
+    lines = [
+        "# AST import and ownership graph audit after M12 repair",
+        "",
+        f"- Python modules parsed: **{len(module_files)}**",
+        f"- Syntax errors: **{len(syntax_errors)}**",
+        f"- Top-level package cycles: **{len(cycles)}**",
+        f"- Runtime dependency violations: **{len(runtime_violations)}**",
+        f"- Lawful M13 transaction-participation edges: **{len(transaction_participation)}**",
+        "",
+        "## Cycles",
+        *([f"- `{component}`" for component in cycles] or ["- None"]),
+        "",
+        "## Runtime dependency violations",
+        *([f"- `{item['source']}` → `{item['target']}`" for item in runtime_violations] or ["- None"]),
+    ]
+    (OUTPUT_ROOT / "AST_IMPORT_GRAPH_SUMMARY_AFTER_REPAIR.md").write_text(
+        "\n".join(lines) + "\n", encoding="utf-8"
+    )
+    print("\n".join(lines))
+
+
+if __name__ == "__main__":
+    main()
