+def test_iter_candidates_preserves_line_column_and_function_context(tmp_path, monkeypatch):
+    source = tmp_path / "sample.py"
+    source.write_text(
+        'first_value = "Temporal Context Draft"\n'
+        'def temporal_context():\n'
+        '    return "Reference Packet Draft"\n',
+        encoding="utf-8",
+    )
+    monkeypatch.chdir(tmp_path)
+
+    occurrences = list(audit._iter_candidates(["sample.py"]))
+
+    temporal_identifier = next(
+        item for item in occurrences if item["raw_phrase"] == "first_value"
+    )
+    function_identifier = next(
+        item for item in occurrences if item["raw_phrase"] == "def temporal_context"
+    )
+    return_label = next(
+        item for item in occurrences if item["raw_phrase"] == "Reference Packet Draft"
+    )
+    assert (temporal_identifier["line"], temporal_identifier["column"]) == (1, 1)
+    assert (function_identifier["line"], function_identifier["column"]) == (2, 5)
+    assert (return_label["line"], return_label["column"]) == (3, 13)
+    assert return_label["source_context"] == '    return "Reference Packet Draft"'
