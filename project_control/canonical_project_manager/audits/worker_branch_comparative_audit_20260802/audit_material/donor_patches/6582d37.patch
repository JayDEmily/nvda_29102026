+def test_prepared_context_packet_rejects_missing_caller_owned_producer_identity() -> None:
+    snapshot = _prepared_snapshot()
+    try:
+        build_prepared_context_packet(
+            packet_id="prepared-context-missing-owner",
+            snapshot=snapshot,
+            derivedfrom="prepared:snap-context-1",
+            emitted_at=datetime(2026, 4, 21, 10, 2, tzinfo=UTC),
+            traceid="trace-missing-owner",
+            runid="run-missing-owner",
